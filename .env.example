# Chave do Google AI Studio (somente servidor, nunca use NEXT_PUBLIC_)
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo de chat: escolha na lista atual do Google (ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 768 e 3072 sao experimentos do eval. Tabela e retriever usam este valor.
EMBEDDING_DIMENSIONS=768

POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/postgres

# Rate limit por IP: janela em segundos e maximo de requisicoes
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=15
